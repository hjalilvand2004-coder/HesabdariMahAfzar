[Unit]
Description=Saman-e Maliyar (FastAPI) - accounting, funding and expense service
After=network.target

[Service]
Type=simple
User=__SVC_USER__
WorkingDirectory=__REPO_DIR__/backend
ExecStart=__REPO_DIR__/backend/venv/bin/python -m uvicorn app.main:app --host __MALIYAR_HOST__ --port __MALIYAR_PORT__
Environment=SAMANE_DB=__REPO_DIR__/backend/samane.db
Environment=SAMANE_UPLOADS=__REPO_DIR__/backend/uploads
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
